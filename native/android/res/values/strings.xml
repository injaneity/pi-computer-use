<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Pi Computer Use</string>
    <string name="service_description">Allow your paired local Pi session to inspect visible app content, take screenshots, and perform taps, text entry, and swipes. UI content can be sent to your configured AI provider by Pi. Enable only when you intend to use automation. Pause or revoke access in Pi Computer Use at any time. This is an automation tool, not a disability accessibility tool.</string>

    <string name="ui_subtitle">Android 预览版 · 只在本机通信</string>

    <string name="ui_section_about">说明</string>
    <string name="ui_about_body">配对后，本机 Pi 可以读取界面和截图，并执行点击、输入和滑动。界面内容可能被发送给你配置的模型服务。</string>
    <string name="ui_about_warning">不要在密码、支付、权限确认等敏感页面使用。随时可以暂停或撤销配对。</string>
    <string name="ui_steps">1. 手动开启无障碍服务。\n2. 在 Termux 运行配对命令。\n3. 粘贴 64 位密钥并确认。</string>

